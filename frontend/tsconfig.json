{
  "compilerOptions": {
    // Keep emitted syntax at the project's documented compatibility target.
    // Raising it is a deliberate output-contract change.
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    // Tests type against the published SDK declaration file, so a broken
    // contract becomes a compile error, not a CI grep.
    "paths": {
      "@sdk": ["../sdk/osfui.d.ts"]
    },
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src", "test", "scripts"],
  "exclude": [
    "node_modules",
    // Frozen public contract, shipped verbatim and never compiled.
    "src/shared-kit/osfui.js",
    "src/shared-kit/gamepadnav.js"
  ]
}
