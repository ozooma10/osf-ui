{
  "name": "create-osfui",
  "version": "0.2.0",
  "description": "Create a directly deployable OSF UI starter for Starfield mods",
  "keywords": [
    "starfield",
    "sfse",
    "osfui"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ozooma10/osf-ui.git",
    "directory": "frontend/packages/create-osfui"
  },
  "homepage": "https://github.com/ozooma10/osf-ui#readme",
  "bugs": {
    "url": "https://github.com/ozooma10/osf-ui/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "create-osfui": "src/cli.mjs"
  },
  "files": [
    "src",
    "templates/projects",
    "package-sdk",
    "scripts/package-sdk.mjs"
  ],
  "dependencies": {
    "@clack/prompts": "^1.7.0"
  },
  "scripts": {
    "prepublishOnly": "npm test",
    "prepack": "node scripts/package-sdk.mjs",
    "postpack": "node scripts/package-sdk.mjs --clean",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20.19"
  },
  "license": "GPL-3.0-or-later"
}
