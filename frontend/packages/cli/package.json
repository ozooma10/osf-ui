{
  "name": "@osfui/cli",
  "version": "0.1.0",
  "description": "Authoring, build, and browser-preview tools for OSF UI views.",
  "license": "GPL-3.0-or-later",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "osfui": "./src/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.mjs"
    },
    "./view": {
      "types": "./types/osfui.d.ts"
    }
  },
  "files": [
    "assets/osfui.css",
    "assets/osfui.js",
    "assets/gamepadnav.js",
    "src",
    "types/osfui.d.ts"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "prepare": "node scripts/sync-public-assets.mjs",
    "test": "node scripts/sync-public-assets.mjs --check && node scripts/run-tests.mjs"
  },
  "dependencies": {
    "typescript": "7.0.2",
    "vite": "8.1.5"
  }
}
