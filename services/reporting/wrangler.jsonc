{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "osfui-reporting",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-27",
  "workers_dev": true,
  "vars": {
    "GITHUB_OWNER": "ozooma10",
    "GITHUB_REPO": "osf-ui",
    "REPORTING_ENABLED": "true",
    "ISSUE_CREATION_ENABLED": "true"
  },
  "triggers": {
    "crons": ["17 4 * * *"]
  },
  "r2_buckets": [
    {
      "binding": "REPORTS",
      "bucket_name": "osfui-bug-reports"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "REPORT_GATE", "class_name": "ReportGate" }
    ]
  },
  "exports": {
    "ReportGate": { "type": "durable-object", "storage": "sqlite" }
  },
  "queues": {
    "producers": [
      { "binding": "REPORT_QUEUE", "queue": "osfui-report-issues" }
    ],
    "consumers": [
      {
        "queue": "osfui-report-issues",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "retry_delay": 60,
        "dead_letter_queue": "osfui-report-issues-dlq",
        "max_concurrency": 1
      }
    ]
  },
  "ratelimits": [
    {
      "name": "CLIENT_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 2,
        "period": 60
      }
    },
    {
      "name": "NETWORK_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 3,
        "period": 60
      }
    },
    {
      "name": "TICKET_LIMITER",
      "namespace_id": "1003",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
