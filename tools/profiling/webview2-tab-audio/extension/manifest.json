{
  "manifest_version": 3,
  "name": "OSF UI isolated tab audio probe",
  "description": "Private WebView2 tab-capture feasibility probe. No page injection.",
  "version": "0.1.0",
  "key": "",
  "permissions": ["tabCapture", "tabs", "activeTab"],
  "background": {
    "service_worker": "worker.js"
  },
  "commands": {
    "start-source-capture": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "Capture the isolated OSF UI source fixture"
    }
  }
}
